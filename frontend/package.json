{
  "name": "dockb-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "DockB desktop markdown editor (Electron + TypeScript thin client)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json && vite build",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "start": "electron ."
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/codemirror": "^5.60.18",
    "@types/node": "^22.5.0",
    "electron": "^32.1.0",
    "eslint": "^9.9.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "markdown-it": "^15.0.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.5"
  }
}
