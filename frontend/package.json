{
  "name": "dockb-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "DockB desktop markdown editor (Electron + TypeScript thin client)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json && vite build",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "start": "electron ."
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.0",
    "electron": "^32.1.0",
    "eslint": "^9.9.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
