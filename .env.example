OPENAI_API_KEY=
NEO4J_URL=bolt://localhost:7687
NEO4J_PASSWORD=
NEO4J_USER=
NEO4J_DATABASE=

DOCKB_CHAPTERS_DIR=
DOCKB_SECRET_KEY=your-very-long-random-secret
DOCKB_FRONTEND_DIST=

# Proofreading (LanguageTool). Enabled by default; set to 0/false to turn the
# editor's spelling and grammar checks off (the endpoint then answers 503).
# DOCKB_PROOFREADING_LANGUAGE is the fallback language, in a LanguageTool code
# (e.g. en-GB for UK English, not en-UK). A writer's choice in Settings ->
# Language is stored per account and overrides it; this value is used only
# until they choose, or if their stored choice is no longer supported.
# DOCKB_LANGUAGETOOL_URL points at an already-running LanguageTool server
# instead of the managed download.
DOCKB_PROOFREADING_ENABLED=true
DOCKB_PROOFREADING_LANGUAGE=en-US
DOCKB_LANGUAGETOOL_URL=

# OpenAI model overrides (defaults: gpt-4o-mini)
DOCKB_CHAT_MODEL=
DOCKB_MENTIONS_MODEL=

# The MCP endpoint's public base URL (e.g. an ngrok reserved domain).
# When unset, editor chat prompts are sent to OpenAI without the MCP tool
# and without a token (README_mcp_auth.md sections 3 and 8).
DOCKB_MCP_PUBLIC_URL=
DOCKB_MCP_PORT=
DOCKB_MCP_ALLOWED_HOSTS=
DOCKB_MCP_TOKEN_TTL_SECONDS=

# SMTP delivery for password-reset links and email one-time codes. Delivery is
# disabled unless DOCKB_SMTP_HOST and DOCKB_EMAIL_FROM are both set; routes
# that need email then answer 503 email_unavailable. DOCKB_PUBLIC_URL is the
# backend origin used to build absolute /editor/?reset-password=<token> links.
DOCKB_SMTP_HOST=
DOCKB_SMTP_PORT=587
DOCKB_SMTP_USERNAME=
DOCKB_SMTP_PASSWORD=
DOCKB_SMTP_USE_TLS=true
DOCKB_EMAIL_FROM=
DOCKB_PUBLIC_URL=http://localhost:8000

# OAuth providers are optional: a provider is enabled only when both of its
# client id+secret are present (README_auth.md section 5).
OAUTH_CALLBACK_PORT=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_SESSION_TTL_HOURS=
